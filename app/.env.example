# AssanPay Developer Console - sandbox-only configuration
# Copy this file to .env for local development, then replace every placeholder.
# Never commit .env or paste real credentials into this example file.
# On Vercel, add these names in Project Settings > Environment Variables.
# A Vercel Production deployment can still use only AssanPay sandbox credentials.

# Public application URL. Set to your deployed HTTPS domain on Vercel.
APP_URL=http://localhost:3000

# Neon PostgreSQL connection string (required for history, saved requests, callbacks, and variables).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth.js / Google OAuth. Add https://YOUR_DOMAIN/api/auth/callback/google
# as an authorized redirect URI in Google Cloud.
AUTH_SECRET=replace_with_a_long_random_auth_secret
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret

# Optional local-only login bypass. Never enable on a deployed site.
DEV_BYPASS_AUTH=false

# Encryption key for user-created secret variables in the database.
# Keep this stable after data is encrypted; changing it prevents decryption.
ENV_VAULT_KEY=replace_with_a_long_random_vault_key

# Credential rules for every country below:
# API_KEY and API_SECRET = branch credentials used for outgoing requests.
# MAIN_API_SECRET = main merchant secret used only to verify incoming callbacks.
# These gateway hosts are carried over from the previous local sandbox setup;
# confirm them with AssanPay before sending requests. No live gateway is configured.

# Pakistan (PKR)
ASSANPAY_PKR_SANDBOX_BASE_URL=https://pc.assanpay.com/
ASSANPAY_PKR_SANDBOX_API_KEY=replace_with_pkr_branch_api_key
ASSANPAY_PKR_SANDBOX_API_SECRET=replace_with_pkr_branch_api_secret
ASSANPAY_PKR_SANDBOX_MAIN_API_SECRET=replace_with_pkr_main_merchant_api_secret

# Bangladesh (BDT)
ASSANPAY_BDT_SANDBOX_BASE_URL=https://bn3.assanpay.com/
ASSANPAY_BDT_SANDBOX_API_KEY=replace_with_bdt_branch_api_key
ASSANPAY_BDT_SANDBOX_API_SECRET=replace_with_bdt_branch_api_secret
ASSANPAY_BDT_SANDBOX_MAIN_API_SECRET=replace_with_bdt_main_merchant_api_secret

# Indonesia (IDR)
ASSANPAY_IDR_SANDBOX_BASE_URL=https://id-sandbox.assanpay.com/
ASSANPAY_IDR_SANDBOX_API_KEY=replace_with_idr_branch_api_key
ASSANPAY_IDR_SANDBOX_API_SECRET=replace_with_idr_branch_api_secret
ASSANPAY_IDR_SANDBOX_MAIN_API_SECRET=replace_with_idr_main_merchant_api_secret

# Philippines (PHP)
ASSANPAY_PHP_SANDBOX_BASE_URL=https://ph-sandbox.assanpay.com/
ASSANPAY_PHP_SANDBOX_API_KEY=replace_with_php_branch_api_key
ASSANPAY_PHP_SANDBOX_API_SECRET=replace_with_php_branch_api_secret
ASSANPAY_PHP_SANDBOX_MAIN_API_SECRET=replace_with_php_main_merchant_api_secret
