# ==============================================================================
# AssanPay API Console & Testing Workspace — Environment Configuration
# ==============================================================================

# Application Base URL (used for callback URLs and OAuth redirects)
APP_URL=https://console.assanpay.com

# ------------------------------------------------------------------------------
# Neon PostgreSQL Database
# ------------------------------------------------------------------------------
# Get this from your Neon Console (e.g. postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5 — Google OAuth Only)
# ------------------------------------------------------------------------------
# Generate a secret: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET=your_32_byte_base64_auth_secret_here

# Google OAuth 2.0 Credentials (Authorized redirect: https://YOUR_DOMAIN/api/auth/callback/google)
# Access is strictly restricted server-side to verified @assanpay.com accounts
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your_google_client_secret

# Optional: Set to true only in local development to bypass Google login offline
DEV_BYPASS_AUTH=false

# ------------------------------------------------------------------------------
# Secret Vault Key (AES-256-GCM encryption for stored environment variables)
# ------------------------------------------------------------------------------
ENV_VAULT_KEY=your_vault_encryption_key_here

# ------------------------------------------------------------------------------
# Pakistan (PKR) Gateway Credentials (Server-Only, Never Returned to Client)
# ------------------------------------------------------------------------------
ASSANPAY_PKR_SANDBOX_BASE_URL=https://sandbox-api.assanpay.com
ASSANPAY_PKR_SANDBOX_API_KEY=your_pkr_sandbox_branch_key
ASSANPAY_PKR_SANDBOX_API_SECRET=your_pkr_sandbox_branch_secret

ASSANPAY_PKR_PRODUCTION_BASE_URL=https://api-pk.assanpay.com
ASSANPAY_PKR_PRODUCTION_API_KEY=your_pkr_prod_branch_key
ASSANPAY_PKR_PRODUCTION_API_SECRET=your_pkr_prod_branch_secret

# ------------------------------------------------------------------------------
# Bangladesh (BDT) Gateway Credentials (Server-Only, Never Returned to Client)
# ------------------------------------------------------------------------------
ASSANPAY_BDT_SANDBOX_BASE_URL=https://sandbox-bdt-api.assanpay.com
ASSANPAY_BDT_SANDBOX_API_KEY=your_bdt_sandbox_branch_key
ASSANPAY_BDT_SANDBOX_API_SECRET=your_bdt_sandbox_branch_secret

ASSANPAY_BDT_PRODUCTION_BASE_URL=https://api.assanpay.com
ASSANPAY_BDT_PRODUCTION_API_KEY=your_bdt_prod_branch_key
ASSANPAY_BDT_PRODUCTION_API_SECRET=your_bdt_prod_branch_secret

# ------------------------------------------------------------------------------
# Indonesia (IDR) Gateway Credentials (Server-Only, Never Returned to Client)
# ------------------------------------------------------------------------------
ASSANPAY_IDR_SANDBOX_BASE_URL=https://id-sandbox.assanpay.com
ASSANPAY_IDR_SANDBOX_API_KEY=your_idr_sandbox_branch_key
ASSANPAY_IDR_SANDBOX_API_SECRET=your_idr_sandbox_branch_secret

ASSANPAY_IDR_PRODUCTION_BASE_URL=https://id.assanpay.com
ASSANPAY_IDR_PRODUCTION_API_KEY=your_idr_prod_branch_key
ASSANPAY_IDR_PRODUCTION_API_SECRET=your_idr_prod_branch_secret

# ------------------------------------------------------------------------------
# Philippines (PHP) Gateway Credentials (Server-Only, Never Returned to Client)
# ------------------------------------------------------------------------------
ASSANPAY_PHP_SANDBOX_BASE_URL=https://ph-sandbox.assanpay.com
ASSANPAY_PHP_SANDBOX_API_KEY=your_php_sandbox_branch_key
ASSANPAY_PHP_SANDBOX_API_SECRET=your_php_sandbox_branch_secret

ASSANPAY_PHP_PRODUCTION_BASE_URL=https://ph.assanpay.com
ASSANPAY_PHP_PRODUCTION_API_KEY=your_php_prod_branch_key
ASSANPAY_PHP_PRODUCTION_API_SECRET=your_php_prod_branch_secret

