# AssanPay Developer Console configuration
# Copy this file to .env for local development, then replace every placeholder.
# Never commit .env or paste real credentials into this example file.
# On Vercel, add these names in Project Settings > Environment Variables.

# Public application URL. Set to your deployed HTTPS domain on Vercel.
# Catalog request bodies use this origin to prefill callbackUrl; localhost is not reachable by AssanPay.
APP_URL=http://localhost:3000

# Neon PostgreSQL connection string (required for history, saved requests, callbacks, and variables).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth.js / Google OAuth. Add https://YOUR_DOMAIN/api/auth/callback/google
# as an authorized redirect URI in Google Cloud.
AUTH_SECRET=replace_with_a_long_random_auth_secret
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret

# Default Merchant Branch Code for outgoing transactions
ASSANPAY_BRANCH_CODE=APTEST01
NEXT_PUBLIC_ASSANPAY_BRANCH_CODE=APTEST01


# Credential rules for every country below:
# API_KEY and API_SECRET = branch credentials used for outgoing requests.
# MAIN_API_SECRET = main merchant secret used only to verify incoming callbacks.
# Confirm these hosts with AssanPay before sending requests.

# Pakistan (PKR)
ASSANPAY_PKR_BASE_URL=https://pc.assanpay.com/
ASSANPAY_PKR_API_KEY=replace_with_pkr_branch_api_key
ASSANPAY_PKR_API_SECRET=replace_with_pkr_branch_api_secret
ASSANPAY_PKR_MAIN_API_SECRET=replace_with_pkr_main_merchant_api_secret

# Bangladesh (BDT)
ASSANPAY_BDT_BASE_URL=https://bn3.assanpay.com/
ASSANPAY_BDT_API_KEY=replace_with_bdt_branch_api_key
ASSANPAY_BDT_API_SECRET=replace_with_bdt_branch_api_secret
ASSANPAY_BDT_MAIN_API_SECRET=replace_with_bdt_main_merchant_api_secret

# Indonesia (IDR)
ASSANPAY_IDR_BASE_URL=https://id-sandbox.assanpay.com/
ASSANPAY_IDR_API_KEY=replace_with_idr_branch_api_key
ASSANPAY_IDR_API_SECRET=replace_with_idr_branch_api_secret
ASSANPAY_IDR_MAIN_API_SECRET=replace_with_idr_main_merchant_api_secret

# Philippines (PHP)
ASSANPAY_PHP_BASE_URL=https://ph-sandbox.assanpay.com/
ASSANPAY_PHP_API_KEY=replace_with_php_branch_api_key
ASSANPAY_PHP_API_SECRET=replace_with_php_branch_api_secret
ASSANPAY_PHP_MAIN_API_SECRET=replace_with_php_main_merchant_api_secret
